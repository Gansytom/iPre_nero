<mujoco model="nero_scene">
  <include file="nero.xml"/>
  <!-- Cinta transportadora (solo escenografia): centrada en x = -0.38 m (zona de trabajo del brazo), a lo largo del eje Y.
       La superficie de la banda queda a z = 0.064 m. -->
  <include file="cinta.xml"/>

  <statistic center="0.2 0 0.2" extent="0.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Cubo de 4 cm (size = semi-dimensiones). Parte en un extremo de la cinta, apoyado
         sobre la banda (z = 0.064 + 0.02). gravcomp="1" anula su peso mientras viaja;
         mujoco_node le impone la velocidad constante y le devuelve la gravedad al agarrarlo. -->
    <body name="cube" pos="-0.38 -0.33 0.084" gravcomp="1">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" rgba="0.2 0.2 0.8 1"
            mass="0.05" friction="1.5 0.01 0.001" condim="4"/>
    </body>
  </worldbody>

  <!-- El cubo no colisiona con el piso ni con la cinta (sin friccion que lo frene),
       pero si con los dedos del gripper (contype/conaffinity por defecto = 1). -->
  <contact>
    <exclude body1="world" body2="cube"/>
    <exclude body1="base_cinta" body2="cube"/>
  </contact>
</mujoco>
